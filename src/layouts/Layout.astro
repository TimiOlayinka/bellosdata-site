---
import '../styles/index.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "BellosData | Analytics Engineered for Growth" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | BellosData</title>
	</head>
	<body>
		<nav class="glass sticky-nav">
			<div class="container nav-content">
				<a href="/" class="logo">
					<img src="/images/bellosdata_logo.png" alt="BellosData" class="logo-img" />
				</a>
				<div class="nav-links">
					<a href="#services">Services</a>
					<a href="#case-studies">Case Studies</a>
					<a href="mailto:contact@bellosdata.com" class="btn-primary">Partner With Us</a>
				</div>
			</div>
		</nav>
		<main>
			<slot />
		</main>
		<footer class="container section-padding">
			<div class="footer-grid">
				<div>
					<img src="/images/bellosdata_logo.png" alt="BellosData" class="footer-logo-img" />
					<p class="text-secondary" style="margin-top:0.75rem;">Analytics Engineered for Growth.</p>
					<p class="text-secondary" style="font-size:0.85rem;margin-top:0.25rem;">www.bellosdata.co.uk</p>
				</div>
				<div class="social-links">
					<a href="https://www.linkedin.com/company/bellosdata/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
					<a href="mailto:contact@bellosdata.co.uk" target="_blank" rel="noopener noreferrer">Email</a>
				</div>
			</div>
			<div class="footer-bottom">
				<p>&copy; {new Date().getFullYear()} BellosData. All rights reserved.</p>
			</div>
		</footer>
	</body>
</html>

<style>
	.sticky-nav {
		position: sticky;
		top: 0;
		z-index: 100;
		border-top: none;
		border-left: none;
		border-right: none;
	}

	.nav-content {
		height: 80px;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		display: flex;
		align-items: center;
	}

	.logo-img {
		height: 48px;
		width: auto;
		object-fit: contain;
	}

	.footer-logo-img {
		height: 56px;
		width: auto;
		object-fit: contain;
	}

	.nav-links {
		display: flex;
		gap: 2.5rem;
		align-items: center;
	}

	.nav-links a {
		font-weight: 500;
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-secondary);
	}

	.nav-links a:hover {
		color: var(--text-primary);
	}

	.btn-primary {
		padding: 0.8rem 1.5rem;
		background: var(--text-primary);
		color: var(--bg-color) !important;
		font-weight: 700 !important;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 4rem;
		border-top: 1px solid var(--glass-border);
		padding-top: 4rem;
	}

	.social-links {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.footer-bottom {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--glass-border);
		font-size: 0.8rem;
		color: var(--text-secondary);
	}

	@media (max-width: 768px) {
		.nav-links {
			display: none;
		}
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
